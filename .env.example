# Keep this file local: .env.local is already ignored by git.
# Without a key, DinkAI falls back to your browser's built-in voice.
ELEVENLABS_API_KEY=

# Optional. Adam is a natural, conversational coaching voice.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Optional. Defaults to ElevenLabs' standard text-to-speech endpoint for the voice above.
# ELEVENLABS_TTS_ENDPOINT=https://api.elevenlabs.io/v1/text-to-speech/your-voice-id

# Optional for a deployed app: URL of your own server-side TTS proxy.
# Never put ELEVENLABS_API_KEY in a VITE_ variable; VITE_ values are public in the browser.
# VITE_TTS_ENDPOINT=https://your-app.example.com/api/voice-review
